EXPO_PUBLIC_API_URL=https://your-verification-domain.example
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Hostname only. The app passes its HTTPS origin to Privy's native passkey API.
EXPO_PUBLIC_PASSKEY_DOMAIN=
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EAS_PROJECT_ID=
# Optional separate Privy browser client, sharing the same Privy app ID.
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
# Website assets/routes prefix for GitHub project Pages; empty on a custom domain.
EXPO_WEB_BASE_URL=/new-tibet-app-testnet-pages
