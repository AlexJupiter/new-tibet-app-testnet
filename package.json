{
  "name": "new-tibet-app-testnet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:mobile": "npm run start -w apps/mobile",
    "build": "npm run build -w apps/api && npm run build -w apps/admin",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "db:migrate": "npm run migrate -w apps/api",
    "contracts:compile": "tsx scripts/compile-contract.ts",
    "mobile:export": "npm run export -w apps/mobile",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "viem": "2.57.5",
    "zod": "4.3.6",
    "decode-uri-component": "file:packages/decoder-compat"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2",
    "tsx": "^4.20.0",
    "vitest": "5.0.4",
    "esbuild": "^0.25.0",
    "solc": "0.8.37",
    "@ethereumjs/vm": "^10.1.0",
    "@ethereumjs/common": "^10.1.0",
    "@ethereumjs/util": "^10.1.0",
    "sharp": "0.35.5",
    "vite": "^6.4.4"
  },
  "overrides": {
    "tmp": "0.2.7",
    "decode-uri-component": "$decode-uri-component",
    "uuid": "11.1.1",
    "sharp": "0.35.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
